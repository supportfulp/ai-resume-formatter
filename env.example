# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
# Optional overrides (defaults: gemini-3.5-flash-lite, model's own thinking level "minimal")
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# File Processing
MAX_FILE_SIZE=10485760
OUTPUT_DIR=output

# Processing Options
DEFAULT_TEMPLATE_STYLE=professional
ENABLE_CONTENT_ENHANCEMENT=true
ENABLE_ATS_OPTIMIZATION=true 